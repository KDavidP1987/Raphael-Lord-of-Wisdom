<Project Sdk="Microsoft.NET.Sdk">
  <!-- 0.72.0: logic tests for the pure parts of Raphael (no Unity, no game). Not in Raphael.sln, so the mod build and the
       release package are untouched. Run: dotnet run -c Release (tools/preflight.ps1 -Mode Release runs it). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <RootNamespace>Raphael.Logic.Tests</RootNamespace>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Raphael\Services\Nyar\NyarFieldRules.cs" Link="Linked\NyarFieldRules.cs" />
    <Compile Include="..\..\Raphael\Services\Nyar\NyarBatch.cs" Link="Linked\NyarBatch.cs" />
    <Compile Include="..\..\Raphael\Services\Nyar\NyarVersion.cs" Link="Linked\NyarVersion.cs" />
    <Compile Include="..\..\Raphael\Services\Nyar\NyarInfoParse.cs" Link="Linked\NyarInfoParse.cs" />
    <Compile Include="..\..\Raphael\Services\Nyar\NyarMessages.cs" Link="Linked\NyarMessages.cs" />
    <Compile Include="..\..\Raphael\Services\Nyar\NyarForm.cs" Link="Linked\NyarForm.cs" />
    <Compile Include="..\..\Raphael\Services\Nyar\NyarLimits.cs" Link="Linked\NyarLimits.cs" />
    <Compile Include="..\..\Raphael\Services\Nyar\NyarHelp.cs" Link="Linked\NyarHelp.cs" />
    <Compile Include="..\..\Raphael\Services\Nyar\NyarHordeCounts.cs" Link="Linked\NyarHordeCounts.cs" />
    <Compile Include="..\..\Raphael\UI\ModContent\RailPolicy.cs" Link="Linked\RailPolicy.cs" />
    <!-- 0.73.0: guide data (pure) and the Bloodcraft reset core. -->
    <Compile Include="..\..\Raphael\Services\Guides\*.cs" Link="Linked\Guides\%(Filename)%(Extension)" />
    <Compile Include="..\..\Raphael\Services\Bloodcraft\BcReset.cs" Link="Linked\BcReset.cs" />
    <Compile Include="..\..\Raphael\Services\Emberglass\EclipseServerMessagePacket.cs" Link="Linked\EclipseServerMessagePacket.cs" />
    <Compile Include="..\..\Raphael\Services\Emberglass\EmberglassBridgeState.cs" Link="Linked\EmberglassBridgeState.cs" />
    <!-- 0.73.0: Kindred admin command templates + the VCF argument encoder (PLAN-ADDENDUM §1). -->
    <Compile Include="..\..\Raphael\Services\VcfArg.cs" Link="Linked\VcfArg.cs" />
    <Compile Include="..\..\Raphael\Services\Uriel\UrielFeatures.cs" Link="Linked\UrielFeatures.cs" />
    <Compile Include="..\..\Raphael\Services\Kindred\KindredAdminCommands.cs" Link="Linked\KindredAdminCommands.cs" />
    <!-- 0.74.0: the unit and object reference (pure parts) and the UnitCatalog view over it. -->
    <Compile Include="..\..\Raphael\Resources\GameCatalog.cs" Link="Linked\GameCatalog.cs" />
    <Compile Include="..\..\Raphael\Resources\GameCatalog.Data.cs" Link="Linked\GameCatalog.Data.cs" />
    <Compile Include="..\..\Raphael\Resources\GameCatalogView.cs" Link="Linked\GameCatalogView.cs" />
    <Compile Include="..\..\Raphael\Resources\UnitCatalog.cs" Link="Linked\UnitCatalog.cs" />
  </ItemGroup>
</Project>

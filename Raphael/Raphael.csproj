<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Identity: change these once. PluginInfo.props uses them to generate
         a MyPluginInfo class at build time (no more dual-maintenance with Plugin.cs).
         Renamed from BloodCraftHub -> Raphael (see RENAME_TO_RAPHAEL.md). AssemblyName drives
         the DLL filename, the C# RootNamespace, AND (via PackageId) the BepInEx plugin GUID
         + the config file name (BepInEx writes kdpen.Raphael.cfg). -->
    <AssemblyName>Raphael</AssemblyName>
    <RootNamespace>Raphael</RootNamespace>
    <Authors>kdpen</Authors>
    <Description>Unified client UI for V Rising server mods — Bloodcraft, Beelzebub, Uriel, Faust, KindredCommands, KindredLogistics — plus a standalone chat window. Surfaces their commands, stats &amp; reporting as buttons, forms &amp; overlays. (Formerly BloodCraftHub.)</Description>
    <Version>0.65.6</Version>
    <PackageId>$(Authors).$(AssemblyName)</PackageId>
    <PackageProjectUrl>https://github.com/KDavidP1987/Raphael-Lord-of-Wisdom</PackageProjectUrl>

    <!-- Optional: copy build output straight into your client's BepInEx plugins dir.
         Override on the command line: dotnet build -p:DeployToClient=true
         Default targets the r2modman / Thunderstore Mod Manager "Default" profile.
         Override the profile name:   -p:R2ModmanProfile=MyProfile
         Or target a non-r2modman install: -p:ClientPluginDirectory="C:\...\VRising\BepInEx\plugins" -->
    <DeployToClient>false</DeployToClient>
    <R2ModmanProfile Condition="'$(R2ModmanProfile)' == ''">Default</R2ModmanProfile>
    <ClientPluginDirectory Condition="'$(ClientPluginDirectory)' == ''">$(APPDATA)\Thunderstore Mod Manager\DataFolder\VRising\profiles\$(R2ModmanProfile)\BepInEx\plugins</ClientPluginDirectory>

    <BepInExVersion>6.0.0-be.733</BepInExVersion>

    <!-- The transitive deps brought in by System.Text.Json 9.0.5 (System.IO.Pipelines,
         Microsoft.Bcl.AsyncInterfaces, etc.) warn that they aren't tested on net6.0.
         V Rising's IL2CPP build forces us to net6.0, so the only real choice is to
         silence the warning. (See https://aka.ms/SuppressTfmSupportBuildWarnings) -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Auto-generates MyPluginInfo.PLUGIN_GUID / PLUGIN_NAME / PLUGIN_VERSION from the props above. -->
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="$(BepInExVersion)" IncludeAssets="compile" />
    <!-- VampireReferenceAssemblies is the newer/more-maintained alternative to VRising.Unhollowed.Client
         that Eclipse uses. Both reference the same underlying interop types. -->
    <PackageReference Include="VampireReferenceAssemblies" Version="1.1.11-r96495-b8" />
    <!-- DELIBERATELY NO System.Text.Json reference: pulling 9.x as a direct package
         causes BepInEx's IL2CPP runtime to look for System.Text.Json.dll 9.0.0.0
         alongside our plugin, which isn't shipped and produces a FileNotFoundException
         at Plugin.Load. The .NET 6 runtime hosted by V Rising doesn't bundle a
         compatible System.Text.Json. We avoid the issue by parsing our tiny
         secrets.json with regex in Resources/SecretManager.cs instead. -->
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\secrets.json" />
    <EmbeddedResource Include="Resources\Localization\English.json" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>Full</DebugType>
  </PropertyGroup>

  <!-- 0.17.2 crash-bisect TEST variants. Pass -p:CrashVariant=NOINPUT|NOCHAT|NOLAYER|NOPATCHES
       to compile a build that HARD-disables one patch group regardless of the user's
       config (see Config/BuildVariant.cs + tools/package-test-variants.ps1). Appends to
       the existing defines; empty (a normal release) adds nothing. -->
  <PropertyGroup Condition=" '$(CrashVariant)' != '' ">
    <DefineConstants>$(DefineConstants);BCH_VARIANT_$(CrashVariant)</DefineConstants>
  </PropertyGroup>

  <Import Project="Manifest.props" />

  <Target Name="DeployToClientDir" AfterTargets="Build" Condition="'$(DeployToClient)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ClientPluginDirectory)" SkipUnchangedFiles="true" />
  </Target>

</Project>
